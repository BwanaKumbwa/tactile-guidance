<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/experiment_setup"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/inputParticipantId"
            android:text="@string/participant_id"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/inputParticipantId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:hint="@string/enter_participant_id"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/conditionGroup"
            android:text="@string/condition"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/conditionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/condition0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/condition_0" />

            <RadioButton
                android:id="@+id/condition1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/condition_1" />

            <RadioButton
                android:id="@+id/condition2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/condition_2" />
        </RadioGroup>

        <Button
            android:id="@+id/buttonStartExperiment"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/start_experiment" />

    </LinearLayout>
</ScrollView>
