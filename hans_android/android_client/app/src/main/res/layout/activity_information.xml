<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/textPattern"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_marginStart="40dp"
        android:text="@string/information"
        android:textColor="@color/black"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battery_firmware"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textPattern"
        app:layout_constraintStart_toStartOf="parent"/>


    <!-- Card Battery -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBattery"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="35dp"
        android:layout_marginTop="50dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:background="@drawable/bg_outline"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/info_battery_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/info_battery_level"
                    android:textColor="#666666"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/battery"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/info_battery_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/info_battery_state"
                    android:textColor="#666666"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/info_battery_level"
                    android:textSize="15sp" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Firmware-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFirmware"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="35dp"
        android:layout_marginTop="30dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardBattery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:background="@drawable/bg_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/firmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/firmware"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/info_firmware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/info_firmware"
                    android:textColor="#666666"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/firmware"
                    android:textSize="15sp" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#4EB92B"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@drawable/bottom_nav"
        app:itemTextColor="@drawable/bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>